# ---------------------------------------------------------------------------
# All of these are optional. The application runs with none of them set.
# ---------------------------------------------------------------------------

# Route outbound scanner traffic through an HTTP forward proxy.
# Only set this if the deployment has no direct egress.
#
# IMPORTANT: with a proxy in play, DNS resolution happens at the proxy, so the
# connect-time address pinning in src/lib/security/http.ts cannot apply. The
# pre-flight resolution check in src/lib/security/url-guard.ts is then the only
# address-level defence. Prefer direct egress where possible.
# SCANNER_PROXY_URL=http://127.0.0.1:3128

# DANGEROUS - local development only.
# Disables the guard that refuses loopback, private, link-local, CGNAT and
# cloud-metadata destinations. It exists so the test suite can scan a fixture
# server on 127.0.0.1. Never set this in a deployment that accepts user input.
# SCANNER_ALLOW_PRIVATE_HOSTS=1
